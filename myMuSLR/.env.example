# MuSLR dataset and official prompts
MUSLR_DATA=/data1/nemo/data/MuSLR
MUSLR_PROMPT_DIR=/data1/nemo/ex_methods/MuSLR/prompts

# All predictions, metadata, and materialized prompt images are written here
MUSLR_OUTPUT_DIR=/data1/nemo/my_projects/IntrinsicSecurity/outputs
MUSLR_LOCAL_MEDIA_ROOT=/data1/nemo/my_projects/IntrinsicSecurity/outputs/muslr_media
MUSLR_METHOD=baseline
MUSLR_MAX_TOKENS=1024
MUSLR_WORKERS=1

# RIPO / vLLM settings (matching 02_pi_engine_text_inference.ipynb)
RIPO_ROOT=/data1/nemo/my_projects/RIPO
RIPO_ENDPOINTS=http://127.0.0.1:22000/v1
RIPO_MODEL=anom-pi
RIPO_API_KEY=EMPTY
RIPO_TIMEOUT=120
RIPO_RETRIES=2
RIPO_ENDPOINT_CONCURRENCY=1

# "data" embeds local images in requests and does not require the vLLM server
# to whitelist the MuSLR and output directories. Use "file" only if both paths
# are covered by vLLM --allowed-local-media-path.
RIPO_IMAGE_URL_MODE=data
